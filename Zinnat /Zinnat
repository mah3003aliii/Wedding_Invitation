    <script>
        const canvas = document.getElementById('sparkles-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2.2 + 0.5;
                this.speedX = Math.random() * 0.4 - 0.2;
                this.speedY = Math.random() * 0.25 + 0.12;
                this.opacity = Math.random() * 0.6 + 0.2;
                this.color = `rgba(${Math.floor(Math.random() * 30 + 200)}, ${Math.floor(Math.random() * 40 + 150)}, ${Math.floor(Math.random() * 30 + 130)}, ${this.opacity})`;
            }

            update() {
                this.x += this.speedX;
                this.y += this.speedY;

                if (this.y > canvas.height) {
                    this.y = 0;
                    this.x = Math.random() * canvas.width;
                }
                if (this.x > canvas.width || this.x < 0) {
                    this.x = Math.random() * canvas.width;
                }
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.opacity;
                ctx.shadowBlur = 3;
                ctx.shadowColor = '#c5a059';
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function initParticles() {
            particles = [];
            for (let i = 0; i < 65; i++) {
                particles.push(new Particle());
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }

        initParticles();
        animateParticles();

        function openEnvelope() {
            const flap = document.getElementById('envelope-flap');
            const card = document.getElementById('invitation-card');
            const seal = document.getElementById('wax-seal');
            const welcome = document.getElementById('welcome-preview');

            seal.style.opacity = '0';
            seal.style.transform = 'scale(0.85) translate(-50%, -200%)';
            seal.style.pointerEvents = 'none';
            welcome.style.opacity = '0';
            welcome.style.transform = 'translateY(15px)';

            flap.classList.add('opened');


            setTimeout(() => {
                card.classList.add('extracted');
                card.style.opacity = '1';
                card.style.pointerEvents = 'auto';
            }, 850);
        }

    </script>
</body>
</html>
